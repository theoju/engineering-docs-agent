{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pr-summarizer output",
  "type": "object",
  "required": ["pr_number", "doc_targets"],
  "additionalProperties": false,
  "properties": {
    "pr_number": { "type": "integer" },
    "what_changed": { "type": ["string", "null"] },
    "why": { "type": ["string", "null"] },
    "breaking": { "type": "boolean" },
    "doc_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lens", "action", "page_hint"],
        "additionalProperties": false,
        "properties": {
          "lens": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["create", "edit"] },
          "page_hint": {
            "type": "string",
            "allOf": [
              { "pattern": "^[^/].*\\.md$" },
              {
                "not": {
                  "pattern": "\\.(py|json|yml|yaml|ts|tsx|js|sh|toml|rs|go|java|cpp|c|h|hpp)$"
                }
              }
            ]
          },
          "doc_kind": { "type": "string", "enum": ["architecture", "decision"] }
        }
      }
    },
    "notes": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "partial": { "type": "boolean" }
  }
}
