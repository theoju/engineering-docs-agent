{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pr-summarizer output",
  "type": "object",
  "required": ["pr_number", "doc_targets"],
  "additionalProperties": false,
  "properties": {
    "pr_number": { "type": "integer" },
    "what_changed": { "type": ["string", "null"] },
    "why": { "type": ["string", "null"] },
    "breaking": { "type": "boolean" },
    "doc_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lens", "action", "page_hint"],
        "additionalProperties": false,
        "properties": {
          "lens": { "type": "string", "enum": ["core", "superpowers"] },
          "action": { "type": "string", "enum": ["create", "edit"] },
          "page_hint": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "create" } } },
            "then": {
              "properties": {
                "page_hint": {
                  "type": "string",
                  "pattern": "^_agent-sandbox/[^/].*\\.md$"
                }
              }
            }
          },
          {
            "if": { "properties": { "action": { "const": "edit" } } },
            "then": {
              "properties": {
                "page_hint": {
                  "type": "string",
                  "pattern": "^[^/].*\\.md$"
                }
              }
            }
          }
        ]
      }
    },
    "notes": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "partial": { "type": "boolean" }
  }
}
