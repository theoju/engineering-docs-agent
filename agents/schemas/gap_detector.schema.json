{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gap-detector output",
  "type": "object",
  "required": ["pr_id", "needs_spec"],
  "properties": {
    "pr_id": { "type": "string" },
    "needs_spec": { "type": "boolean" },
    "reasoning": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "tier": { "type": "string" }
  }
}
